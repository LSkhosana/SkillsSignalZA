# Copy this file to `.env` and replace the placeholders.
# Only publishable, client-safe values belong here.
# Never put service-role keys, database passwords, or other secrets
# in variables prefixed with EXPO_PUBLIC_ — they are bundled into the app.

EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
