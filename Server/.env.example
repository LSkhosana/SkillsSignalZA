# Copy this file to `.env` for local development.
# Never commit real secrets. Configure production values in Render.

APP_NAME=SkillSignalZA API
APP_VERSION=0.1.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Comma-separated browser origins. Do not use * with credentials.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Optional until persistence is approved. The API starts without these.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
