{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillsignalza.invalid/schemas/golden-fixture.json",
  "title": "SkillSignalZA Package C golden candidate fixture",
  "description": "Fixture-only envelope for immutable synthetic assessment examples. Unknown top-level properties are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_id",
    "acceptance_requirement",
    "title",
    "fixture_kind",
    "contract_version",
    "rubric_version",
    "track",
    "description",
    "assessment_input",
    "source_records",
    "evidence_facts",
    "expected"
  ],
  "properties": {
    "fixture_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^c[0-9]{2}\\."
    },
    "acceptance_requirement": {
      "type": "integer",
      "minimum": 1,
      "maximum": 22
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "fixture_kind": {
      "type": "string",
      "enum": [
        "completed_assessment",
        "review_required",
        "normalization_invariant",
        "band_table",
        "determinism_invariant",
        "technical_failure",
        "security_invariant"
      ]
    },
    "contract_version": {
      "type": "string",
      "const": "1.2.0"
    },
    "rubric_version": {
      "type": "string",
      "const": "V2"
    },
    "track": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["software_engineering", "data_analytics"]
        },
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "assessment_input": {
      "type": ["object", "null"]
    },
    "source_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_type",
          "submitted_by_candidate",
          "access_status",
          "ownership_status",
          "retrieved_at",
          "content_hash",
          "extractor_version",
          "locator",
          "notes"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "enum": [
              "cv",
              "repository",
              "portfolio",
              "project",
              "deployed_project",
              "kaggle",
              "dashboard",
              "other_professional"
            ]
          },
          "submitted_by_candidate": {
            "type": "boolean"
          },
          "access_status": {
            "type": "string",
            "enum": [
              "accessible",
              "inaccessible",
              "unsafe",
              "unsupported",
              "not_attempted"
            ]
          },
          "ownership_status": {
            "type": "string",
            "enum": ["attributed", "unclear", "conflicting"]
          },
          "retrieved_at": {
            "type": ["string", "null"]
          },
          "content_hash": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "extractor_version": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "evidence_facts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "scoring_context": {
      "type": "object"
    },
    "expected": {
      "type": "object",
      "minProperties": 1
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secret_sentinel": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assertions": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "fixture_kind": {
            "not": {
              "enum": ["band_table", "technical_failure"]
            }
          },
          "track": {
            "type": "string"
          }
        },
        "required": ["fixture_kind", "track"]
      },
      "then": {
        "required": ["scoring_context"]
      }
    },
    {
      "if": {
        "properties": {
          "fixture_kind": {
            "enum": ["band_table", "technical_failure"]
          }
        },
        "required": ["fixture_kind"]
      },
      "then": {
        "not": {
          "required": ["scoring_context"]
        }
      }
    }
  ]
}
