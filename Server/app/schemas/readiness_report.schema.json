{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillsignalza.invalid/schemas/readiness-report.json",
  "title": "SkillSignalZA readiness report payload",
  "description": "Full paid Readiness Report assembled from a completed canonical assessment_result. Does not include PDF layout or hiring claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_version",
    "assessment_id",
    "run_id",
    "contract_version",
    "rubric_version",
    "track",
    "track_label",
    "assessed_at",
    "benchmark",
    "score_summary",
    "category_breakdown",
    "strengths",
    "material_gaps",
    "priority_actions",
    "project_recommendation",
    "criterion_breakdown"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "readiness.report.v1" },
    "report_version": { "type": "string", "const": "1.0.0" },
    "assessment_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "contract_version": { "type": "string", "const": "1.2.0" },
    "rubric_version": { "type": "string", "const": "V2" },
    "track": { "type": "string", "enum": ["software_engineering", "data_analytics"] },
    "track_label": { "type": "string", "minLength": 1 },
    "assessed_at": { "type": "string", "format": "date-time" },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_statement", "disclaimer"],
      "properties": {
        "scope_statement": { "type": "string", "minLength": 1 },
        "disclaimer": { "type": "string", "minLength": 1 }
      }
    },
    "score_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_score",
        "score_max",
        "raw_total",
        "band_id",
        "band_label",
        "strongest_area",
        "priority_gap",
        "category_caps",
        "overall_caps",
        "applicable_overall_cap"
      ],
      "properties": {
        "final_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "score_max": { "type": "integer", "const": 100 },
        "raw_total": { "type": "integer", "minimum": 0, "maximum": 100 },
        "band_id": {
          "type": "string",
          "enum": [
            "limited_application_evidence",
            "foundation_visible",
            "developing_application_readiness",
            "strong_application_evidence"
          ]
        },
        "band_label": { "type": "string", "minLength": 1 },
        "strongest_area": { "$ref": "#/$defs/strongest_area" },
        "priority_gap": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": [
            "criterion_id",
            "criterion_label",
            "category_id",
            "category_label",
            "point_gap",
            "gap_ratio",
            "current_anchor",
            "current_anchor_label",
            "awarded_points",
            "max_points"
          ],
          "properties": {
            "criterion_id": { "type": "string", "minLength": 1 },
            "criterion_label": { "type": "string", "minLength": 1 },
            "category_id": { "type": "string", "minLength": 1 },
            "category_label": { "type": "string", "minLength": 1 },
            "point_gap": { "type": "integer", "minimum": 0 },
            "gap_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "current_anchor": { "type": "string", "minLength": 1 },
            "current_anchor_label": { "type": "string", "minLength": 1 },
            "awarded_points": { "type": "integer", "minimum": 0 },
            "max_points": { "type": "integer", "minimum": 1 }
          }
        },
        "category_caps": {
          "type": "array",
          "items": { "$ref": "#/$defs/category_cap" }
        },
        "overall_caps": {
          "type": "array",
          "items": { "$ref": "#/$defs/overall_cap" }
        },
        "applicable_overall_cap": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "category_breakdown": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/category_row" }
    },
    "strengths": {
      "type": "array",
      "items": { "$ref": "#/$defs/strength_row" }
    },
    "material_gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/gap_row" }
    },
    "priority_actions": {
      "type": "array",
      "maxItems": 5,
      "items": { "$ref": "#/$defs/action_row" }
    },
    "project_recommendation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "type": "string", "const": "REVIEW_REQUIRED" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "project_id",
            "title",
            "scenario",
            "required_foundations",
            "required_outputs",
            "completion_checks",
            "source_blueprint",
            "catalogue_version"
          ],
          "properties": {
            "status": { "type": "string", "const": "RECOMMENDED" },
            "project_id": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "scenario": { "type": "string", "minLength": 1 },
            "required_foundations": { "type": "array", "items": { "type": "string" } },
            "required_outputs": { "type": "array", "items": { "type": "string" } },
            "completion_checks": { "type": "array", "items": { "type": "string" } },
            "data_requirement": { "type": "string", "minLength": 1 },
            "source_blueprint": { "type": "string", "minLength": 1 },
            "catalogue_version": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "criterion_breakdown": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "items": { "$ref": "#/$defs/criterion_row" }
    }
  },
  "$defs": {
    "strongest_area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_id", "label", "score", "max_points", "percentage"],
      "properties": {
        "category_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "score": { "type": "integer", "minimum": 0 },
        "max_points": { "type": "integer", "minimum": 1 },
        "percentage": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "category_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_id", "label", "score", "max_points", "percentage", "pre_cap_score"],
      "properties": {
        "category_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "score": { "type": "integer", "minimum": 0 },
        "max_points": { "type": "integer", "minimum": 1 },
        "percentage": { "type": "integer", "minimum": 0, "maximum": 100 },
        "pre_cap_score": { "type": "integer", "minimum": 0 }
      }
    },
    "strength_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "criterion_label",
        "category_id",
        "category_label",
        "awarded_points",
        "max_points",
        "anchor",
        "anchor_label",
        "evidence_note"
      ],
      "properties": {
        "criterion_id": { "type": "string", "minLength": 1 },
        "criterion_label": { "type": "string", "minLength": 1 },
        "category_id": { "type": "string", "minLength": 1 },
        "category_label": { "type": "string", "minLength": 1 },
        "awarded_points": { "type": "integer", "minimum": 0 },
        "max_points": { "type": "integer", "minimum": 1 },
        "anchor": { "type": "string", "minLength": 1 },
        "anchor_label": { "type": "string", "minLength": 1 },
        "evidence_note": { "type": "string" }
      }
    },
    "gap_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "criterion_label",
        "category_id",
        "category_label",
        "point_gap",
        "gap_ratio",
        "current_anchor",
        "current_anchor_label",
        "awarded_points",
        "max_points"
      ],
      "properties": {
        "criterion_id": { "type": "string", "minLength": 1 },
        "criterion_label": { "type": "string", "minLength": 1 },
        "category_id": { "type": "string", "minLength": 1 },
        "category_label": { "type": "string", "minLength": 1 },
        "point_gap": { "type": "integer", "minimum": 0 },
        "gap_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "current_anchor": { "type": "string", "minLength": 1 },
        "current_anchor_label": { "type": "string", "minLength": 1 },
        "awarded_points": { "type": "integer", "minimum": 0 },
        "max_points": { "type": "integer", "minimum": 1 }
      }
    },
    "action_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority_order",
        "action_id",
        "criterion_id",
        "criterion_label",
        "current_anchor",
        "current_anchor_label",
        "target_anchor",
        "target_anchor_label",
        "candidate_instruction",
        "required_output",
        "completion_check",
        "action_type"
      ],
      "properties": {
        "priority_order": { "type": "integer", "minimum": 1 },
        "action_id": { "type": "string", "minLength": 1 },
        "criterion_id": { "type": "string", "minLength": 1 },
        "criterion_label": { "type": "string", "minLength": 1 },
        "current_anchor": { "type": "string", "minLength": 1 },
        "current_anchor_label": { "type": "string", "minLength": 1 },
        "target_anchor": { "type": "string", "minLength": 1 },
        "target_anchor_label": { "type": "string", "minLength": 1 },
        "candidate_instruction": { "type": "string", "minLength": 1 },
        "required_output": { "type": "string", "minLength": 1 },
        "completion_check": { "type": "string", "minLength": 1 },
        "action_type": { "type": "string", "minLength": 1 }
      }
    },
    "criterion_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "criterion_label",
        "category_id",
        "category_label",
        "awarded_points",
        "max_points",
        "anchor",
        "anchor_label",
        "evidence_note",
        "flags"
      ],
      "properties": {
        "criterion_id": { "type": "string", "minLength": 1 },
        "criterion_label": { "type": "string", "minLength": 1 },
        "category_id": { "type": "string", "minLength": 1 },
        "category_label": { "type": "string", "minLength": 1 },
        "awarded_points": { "type": "integer", "minimum": 0 },
        "max_points": { "type": "integer", "minimum": 1 },
        "anchor": { "type": "string", "minLength": 1 },
        "anchor_label": { "type": "string", "minLength": 1 },
        "evidence_note": { "type": "string" },
        "flags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "category_cap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "rule_label", "category_id", "category_label", "cap"],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "rule_label": { "type": "string", "minLength": 1 },
        "category_id": { "type": "string", "minLength": 1 },
        "category_label": { "type": "string", "minLength": 1 },
        "cap": { "type": "integer", "minimum": 0 }
      }
    },
    "overall_cap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "rule_label", "cap"],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "rule_label": { "type": "string", "minLength": 1 },
        "cap": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
