{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillsignalza.invalid/schemas/anonymous-assessment-response.json",
  "title": "SkillSignalZA anonymous assessment submission outcome",
  "description": "Customer-facing Package N outcome. Returns identity, a one-time claim token, and readiness.preview.v1 only. Never includes the paid readiness report or Package K internals.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "assessment_id",
    "run_id",
    "access_state",
    "claim_token",
    "preview",
    "error_code"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "anonymous.assessment.v1"
    },
    "state": {
      "type": "string",
      "enum": ["COMPLETED", "REVIEW_REQUIRED", "NOT_SCORABLE", "FAILED"]
    },
    "assessment_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "access_state": {
      "type": ["string", "null"],
      "enum": ["PREVIEW", null]
    },
    "claim_token": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "preview": {
      "oneOf": [
        { "$ref": "https://skillsignalza.invalid/schemas/readiness-preview.json" },
        { "type": "null" }
      ]
    },
    "error_code": {
      "type": ["string", "null"],
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "state": { "const": "COMPLETED" } },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "error_code": { "type": "null" },
          "preview": { "type": "object" },
          "assessment_id": { "type": "string", "minLength": 1 },
          "run_id": { "type": "string", "minLength": 1 },
          "access_state": { "const": "PREVIEW" }
        }
      }
    },
    {
      "if": {
        "properties": { "state": { "enum": ["REVIEW_REQUIRED", "NOT_SCORABLE"] } },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "preview": { "type": "null" },
          "assessment_id": { "type": "string", "minLength": 1 },
          "run_id": { "type": "string", "minLength": 1 },
          "access_state": { "const": "PREVIEW" }
        }
      }
    },
    {
      "if": {
        "properties": { "state": { "const": "FAILED" } },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "error_code": { "type": "string", "minLength": 1 },
          "preview": { "type": "null" }
        }
      }
    }
  ]
}
