{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillsignalza.invalid/schemas/assessment-result.json",
  "title": "SkillSignalZA canonical assessment result",
  "description": "Completed deterministic scoring output. Does not include PDF layout or hiring claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_id",
    "run_id",
    "contract_version",
    "rubric_version",
    "track",
    "status",
    "assessed_at",
    "source_snapshot",
    "category_results",
    "criterion_results",
    "category_caps",
    "raw_total",
    "overall_caps",
    "applicable_overall_cap",
    "final_score",
    "band",
    "strengths",
    "material_gaps",
    "priority_actions",
    "project_recommendation",
    "flags",
    "qa"
  ],
  "properties": {
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "rubric_version": {
      "type": "string",
      "const": "V2"
    },
    "track": {
      "type": "string",
      "enum": ["software_engineering", "data_analytics"]
    },
    "status": {
      "type": "string",
      "const": "COMPLETED",
      "description": "This schema validates the canonical completed scoring result only."
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cv_hash", "link_content_hashes"],
      "properties": {
        "cv_hash": {
          "$ref": "#/$defs/sha256"
        },
        "link_content_hashes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "category_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category_id", "max_points", "pre_cap_score", "final_score"],
        "properties": {
          "category_id": {
            "type": "string",
            "minLength": 1
          },
          "max_points": {
            "$ref": "#/$defs/non_negative_integer"
          },
          "pre_cap_score": {
            "$ref": "#/$defs/non_negative_integer"
          },
          "final_score": {
            "$ref": "#/$defs/non_negative_integer"
          }
        }
      }
    },
    "criterion_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "category_id",
          "max_points",
          "anchor",
          "awarded_points",
          "evidence_ids",
          "rule_ids",
          "evidence_note",
          "flags"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "category_id": {
            "type": "string",
            "minLength": 1
          },
          "max_points": {
            "$ref": "#/$defs/non_negative_integer"
          },
          "anchor": {
            "$ref": "#/$defs/approved_anchor"
          },
          "awarded_points": {
            "$ref": "#/$defs/non_negative_integer"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rule_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_note": {
            "type": "string",
            "minLength": 1
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "category_caps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/triggered_cap"
      }
    },
    "raw_total": {
      "$ref": "#/$defs/non_negative_integer"
    },
    "overall_caps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/triggered_cap"
      }
    },
    "applicable_overall_cap": {
      "$ref": "#/$defs/score_0_to_100"
    },
    "final_score": {
      "$ref": "#/$defs/score_0_to_100"
    },
    "band": {
      "type": "string",
      "enum": [
        "limited_application_evidence",
        "foundation_visible",
        "developing_application_readiness",
        "strong_application_evidence"
      ]
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id"],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "awarded_points": {
            "$ref": "#/$defs/non_negative_integer"
          },
          "max_points": {
            "$ref": "#/$defs/non_negative_integer"
          }
        }
      }
    },
    "material_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id"],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "point_gap": {
            "$ref": "#/$defs/non_negative_integer"
          },
          "gap_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "priority_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "criterion_id",
          "current_anchor",
          "target_anchor",
          "required_output",
          "completion_check",
          "priority_order"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "current_anchor": {
            "$ref": "#/$defs/approved_anchor"
          },
          "target_anchor": {
            "$ref": "#/$defs/approved_anchor"
          },
          "required_output": {
            "type": "string",
            "minLength": 1
          },
          "completion_check": {
            "type": "string",
            "minLength": 1
          },
          "priority_order": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "project_recommendation": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "const": "PROJECT_RECOMMENDATION_REVIEW_REQUIRED"},
        {
          "type": "object",
          "required": ["project_id"],
          "properties": {
            "project_id": {
              "type": "string",
              "minLength": 1
            },
            "catalogue_version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PASS", "FAIL"]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "passed"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "passed": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "approved_anchor": {
      "type": "string",
      "enum": [
        "demonstrated",
        "documented",
        "named_only",
        "missing_unverifiable",
        "se.qual.completed",
        "se.qual.in_progress",
        "se.qual.experience",
        "se.qual.bootcamp",
        "se.qual.adjacent",
        "se.qual.none",
        "da.qual.completed",
        "da.qual.in_progress",
        "da.qual.experience",
        "da.qual.bootcamp",
        "da.qual.adjacent",
        "da.qual.none"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "non_negative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "score_0_to_100": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "triggered_cap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "cap"],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "cap": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "category_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
